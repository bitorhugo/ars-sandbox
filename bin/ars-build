#!/usr/bin/env bash
# Build the ars-sandbox image. Extra arguments are passed to `docker build`
# (e.g. --no-cache, --build-arg INSTALL_TECTONIC=true).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
IMAGE="${ARS_SANDBOX_IMAGE:-ars-sandbox:latest}"
ARS_REPO="https://github.com/Imbad0202/academic-research-skills.git"
ARS_REF="${ARS_SANDBOX_ARS_REF:-latest}"

# Resolve "latest" here rather than only inside the Dockerfile: passing the
# concrete tag as a build arg invalidates Docker's layer cache when a new ARS
# release appears.
if [ "$ARS_REF" = "latest" ]; then
  ARS_REF="$(git ls-remote --tags --refs "$ARS_REPO" \
    | sed 's|.*refs/tags/||' | grep -E '^v[0-9]+(\.[0-9]+)*$' | sort -V | tail -n 1 || true)"
  if [ -z "$ARS_REF" ]; then
    echo "ars-build: could not resolve the latest ARS release" >&2
    exit 1
  fi
fi
echo "ars-build: building with ARS $ARS_REF" >&2

docker build \
  --build-arg "ARS_REPO=$ARS_REPO" \
  --build-arg "ARS_REF=$ARS_REF" \
  --build-arg "UID=$(id -u)" \
  --build-arg "GID=$(id -g)" \
  -t "$IMAGE" \
  "$@" \
  "$REPO_ROOT"
